---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/Sections/PageHeader.astro";
import BlogCard from "../../components/Cards/BlogCard.astro";
import Button from "../../components/UI/Button.astro";
import { formatDate } from "../../utils/dateUtils";
import { getCollection } from "astro:content";

// Astro runs this separately to split posts into pages (12 per page).
export async function getStaticPaths({ paginate }) {
  const all = await getCollection("blog", ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  const sorted = all.sort(
    (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );
  return paginate(sorted, { pageSize: 12 });
}

const { page } = Astro.props;

// Full list, used only for the filter tags and the search index
const allPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];

const searchIndex = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description ?? "",
  author: p.data.author ?? "",
  date: p.data.pubDate.toISOString().slice(0, 10),
  dateLabel: formatDate(p.data.pubDate),
  tags: p.data.tags ?? [],
  href: `/blog/${p.id}`,
  image: p.data.image?.url ?? "",
  imageAlt: p.data.image?.alt ?? "",
}));
const searchJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");

const pageHref = (n) => (n === 1 ? "/blog" : `/blog/${n}`);
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

<BaseLayout
  title="Blog - Church Name"
  description="Read our latest articles, devotionals, and updates from our church community."
>
  <PageHeader
    title="Posts"
    subtitle="Insights, devotionals, and updates from our church community"
    backgroundImage="/uploads/blog-header-bg.webp"
  />

  <section class="py-16">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Filters Sidebar -->
        <div class="lg:col-span-1">
          <div class="bg-white p-6 rounded-lg shadow-sm sticky top-24">
            <h2 class="text-xl font-bold mb-6">Filter Posts</h2>

            <div class="mb-6">
              <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search</label>
              <input
                type="text"
                id="search"
                placeholder="Search posts..."
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"
              />
            </div>

            {
              tags.length > 0 && (
                <div class="mb-6">
                  <h3 class="block text-sm font-medium text-gray-700 mb-2">Tags</h3>
                  <div class="space-y-2">
                    {tags.map((tag) => (
                      <label class="flex items-center">
                        <input type="checkbox" class="tag-checkbox h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" value={tag} />
                        <span class="ml-2 text-gray-700">{tag}</span>
                      </label>
                    ))}
                  </div>
                </div>
              )
            }

            <div class="mb-6">
              <label for="author" class="block text-sm font-medium text-gray-700 mb-1">Author</label>
              <input
                type="text"
                id="author"
                placeholder="Filter by author..."
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"
              />
            </div>

            <div class="space-y-3">
              <label class="block text-sm font-medium text-gray-700">Date Range</label>
              <div>
                <label for="from-date" class="block text-xs text-gray-500 mb-1">From</label>
                <input
                  type="date"
                  id="from-date"
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"
                />
              </div>
              <div>
                <label for="to-date" class="block text-xs text-gray-500 mb-1">To</label>
                <input
                  type="date"
                  id="to-date"
                  class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-primary-500 focus:border-primary-500"
                />
              </div>
            </div>

            <button
              id="reset-filters"
              class="w-full mt-6 px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2"
            >
              Reset Filters
            </button>
          </div>
        </div>

        <!-- Blog Posts -->
        <div class="lg:col-span-3">
          <h2 class="text-2xl font-bold mb-6">All Posts</h2>

          <!-- Normal paginated list -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="posts-grid">
            {page.data.map((post) => (
              <BlogCard post={post} className="blog-card" />
            ))}
          </div>

          {
            page.lastPage > 1 && (
              <nav id="pagination" aria-label="Blog pages" class="mt-10 flex items-center justify-center gap-2 flex-wrap">
                {page.currentPage > 1 && (
                  <a href={pageHref(page.currentPage - 1)} class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                    Previous
                  </a>
                )}
                {pageNumbers.map((n) => (
                  <a
                    href={pageHref(n)}
                    aria-current={n === page.currentPage ? "page" : undefined}
                    class={
                      n === page.currentPage
                        ? "px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-md"
                        : "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
                    }
                  >
                    {n}
                  </a>
                ))}
                {page.currentPage < page.lastPage && (
                  <a href={pageHref(page.currentPage + 1)} class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                    Next
                  </a>
                )}
              </nav>
            )
          }

          <!-- Filtered results (filled by the script below) -->
          <p id="result-count" class="text-sm text-gray-600 mb-4" style="display:none"></p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="filter-results" style="display:none"></div>

          <div id="no-results" class="hidden text-center py-12 bg-gray-50 rounded-lg mt-8">
            <p class="text-gray-600">No posts match your search criteria. Please try different filters.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Data for the filters -->
  <script type="application/json" id="post-index" is:inline set:html={searchJson}></script>
  <template id="read-more-tpl">
    <Button href="__HREF__" variant="primary" size="sm">Read More</Button>
  </template>

  <script>
    const indexEl = document.getElementById("post-index");
    const index = indexEl ? JSON.parse(indexEl.textContent || "[]") : [];
    const readMoreTpl = document.getElementById("read-more-tpl")?.innerHTML ?? "";
    const MAX_RESULTS = 60;

    const searchInput = document.getElementById("search");
    const authorInput = document.getElementById("author");
    const tagCheckboxes = document.querySelectorAll(".tag-checkbox");
    const fromDateInput = document.getElementById("from-date");
    const toDateInput = document.getElementById("to-date");
    const resetButton = document.getElementById("reset-filters");
    const postsGrid = document.getElementById("posts-grid");
    const pagination = document.getElementById("pagination");
    const results = document.getElementById("filter-results");
    const resultCount = document.getElementById("result-count");
    const noResults = document.getElementById("no-results");

    const esc = (s) =>
      String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");

    // Same markup as BlogCard.astro
    const cardHtml = (p) => `
      <div class="card group overflow-hidden flex flex-col h-full">
        ${p.image ? `
          <a href="${esc(p.href)}" class="overflow-hidden aspect-video block">
            <img src="${esc(p.image)}" alt="${esc(p.imageAlt)}" loading="lazy"
              class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-105" />
          </a>` : ""}
        <div class="p-5 flex flex-col flex-1">
          <a href="${esc(p.href)}" class="block">
            <h3 class="mb-2 text-xl font-bold group-hover:text-primary-600 transition-colors">${esc(p.title)}</h3>
          </a>
          <div class="text-gray-700 flex flex-col flex-1">
            <div class="mb-3 flex items-center text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>${esc(p.dateLabel)}</span>
            </div>
            <div class="mb-3 flex items-center text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>${esc(p.author)}</span>
            </div>
            <p class="text-gray-700 mb-4 line-clamp-3">${esc(p.description)}</p>
            ${p.tags.length ? `
              <div class="flex flex-wrap gap-2 mb-4">
                ${p.tags.map((t) => `<span class="px-2 py-1 text-xs font-medium text-primary-700 bg-primary-100 rounded-full">${esc(t)}</span>`).join("")}
              </div>` : ""}
            <div class="mt-auto">${readMoreTpl.replace(/__HREF__/g, esc(p.href))}</div>
          </div>
        </div>
      </div>`;

    const filterPosts = () => {
      const searchTerm = searchInput?.value.toLowerCase() || "";
      const authorTerm = authorInput?.value.toLowerCase() || "";
      const fromDate = fromDateInput?.value || "";
      const toDate = toDateInput?.value || "";
      const selectedTags = Array.from(tagCheckboxes)
        .filter((c) => c.checked)
        .map((c) => c.value);

      const hasFilter = searchTerm || authorTerm || fromDate || toDate || selectedTags.length > 0;

      if (!hasFilter) {
        // Back to the normal paginated view
        postsGrid.style.display = "";
        if (pagination) pagination.style.display = "";
        results.style.display = "none";
        resultCount.style.display = "none";
        noResults.style.display = "none";
        return;
      }

      const matches = index.filter((p) => {
        const matchesSearch =
          p.title.toLowerCase().includes(searchTerm) ||
          p.description.toLowerCase().includes(searchTerm);
        const matchesAuthor = !authorTerm || p.author.toLowerCase().includes(authorTerm);
        const matchesFrom = !fromDate || p.date >= fromDate;
        const matchesTo = !toDate || p.date <= toDate;
        const matchesTags = selectedTags.length === 0 || selectedTags.some((t) => p.tags.includes(t));
        return matchesSearch && matchesAuthor && matchesFrom && matchesTo && matchesTags;
      });

      postsGrid.style.display = "none";
      if (pagination) pagination.style.display = "none";

      const shown = matches.slice(0, MAX_RESULTS);
      results.innerHTML = shown.map(cardHtml).join("");
      results.style.display = shown.length ? "grid" : "none";
      noResults.style.display = shown.length ? "none" : "block";

      resultCount.style.display = shown.length ? "block" : "none";
      resultCount.textContent =
        matches.length > MAX_RESULTS
          ? `Showing the first ${MAX_RESULTS} of ${matches.length} matching posts. Narrow your search to see more.`
          : `${matches.length} matching post${matches.length === 1 ? "" : "s"}`;
    };

    searchInput?.addEventListener("input", filterPosts);
    authorInput?.addEventListener("input", filterPosts);
    tagCheckboxes.forEach((c) => c.addEventListener("change", filterPosts));
    fromDateInput?.addEventListener("change", filterPosts);
    toDateInput?.addEventListener("change", filterPosts);

    resetButton?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      if (authorInput) authorInput.value = "";
      tagCheckboxes.forEach((c) => (c.checked = false));
      if (fromDateInput) fromDateInput.value = "";
      if (toDateInput) toDateInput.value = "";
      filterPosts();
    });
  </script>
</BaseLayout>