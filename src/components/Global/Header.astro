---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-md shadow-sm">
  <div class="container flex items-center justify-between h-20">
    <a href="/" class="text-2xl font-bold text-primary-800 font-serif flex items-center">
      <span class="sr-only">St. Peters Arlington</span>
      <img
        src="/logo.png"
        alt="Church Name logo"
        class="h-12 w-auto mr-2"
        width="48"
        height="48"
      />
      <span class="text-primary-800">St. Peteres Arlington</span>
    </a>
    
    <Navigation />
  </div>
</header>